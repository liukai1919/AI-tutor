        { "type": "final", "output": { "kind": "answer", "text": "37 × 24 = 888. Split it: 37 × 20 = 740 and 37 × 4 = 148, then 740 + 148 = 888.", "scope": "math", "checks": [{ "expression": "37*24", "value": 888 }, { "expression": "740+148", "value": 888 }] } }
      ],
      "expect": { "kind": "answer", "stage": "model", "tools": ["calculator.evaluate"], "classifierCalls": 1, "modelCalls": 2, "textIncludes": "888" } },

