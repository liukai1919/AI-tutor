  "bigIdeas": [
    {
      "strand": "algebra",
      "en": "Algebra allows us to generalize relationships through abstract thinking.",
      "zh": "代数让我们通过抽象思维，把具体关系归纳成一般规律。"
    },
    {
      "strand": "number-radicals",
      "en": "The meanings of, and connections between, operations extend to powers, radicals, and polynomials.",
      "zh": "运算的意义及运算之间的联系，扩展到乘方、根式和多项式。"
    },
    {
      "strand": "quadratics",
      "en": "Quadratic relationships are prevalent in the world around us.",
      "zh": "二次关系在我们身边的世界里随处可见。"
    },
    {
      "strand": "trigonometry",
      "en": "Trigonometry involves using proportional reasoning to solve indirect measurement problems.",
      "zh": "三角学运用比例推理，解决那些没法直接量出来的测量问题。"
    }
  ],
