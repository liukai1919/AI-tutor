  "skills": [
    { "id": "YY.MATH.INT.CONCEPT", "topic": "integers", "type": "concept", "rep": ["numberLine", "context"],
      "en": "Understand negative numbers on a number line and in context (temperature, elevation, money)",
      "zh": "在数轴和生活里认识负数（温度、海拔、账户）",
      "primary": "BC.MATH.G7.FLU.02", "prereq": ["YY.MATH.NUM.PVBIG.COMPARE_ORDER"], "misc": ["int.negative_bigger_magnitude"], "hints": "numberLine" },
    { "id": "YY.MATH.INT.COMPARE_ORDER", "topic": "integers", "type": "procedure", "rep": ["numberLine", "symbolic"],
      "en": "Compare and order integers; find opposites",
      "zh": "比较和排序整数，找相反数",
      "primary": "BC.MATH.G7.FLU.02", "prereq": ["YY.MATH.INT.CONCEPT"], "misc": ["int.negative_bigger_magnitude"], "hints": "numberLine" },
    { "id": "YY.MATH.INT.ADD", "topic": "integers", "type": "procedure", "rep": ["groups", "numberLine", "symbolic"],
      "en": "Add integers with two-colour counters and number lines, then symbolically",
      "zh": "整数加法：先用双色筹码、数轴，再用符号算",
      "primary": "BC.MATH.G7.FLU.02", "prereq": ["YY.MATH.INT.COMPARE_ORDER"], "misc": ["int.add_ignore_sign"], "hints": "numberLine、groups" },
    { "id": "YY.MATH.INT.SUBTRACT", "topic": "integers", "type": "procedure", "rep": ["numberLine", "symbolic"],
      "en": "Subtract integers, including subtracting a negative (9 − (−4) = 13)",
      "zh": "整数减法，包括减去负数（9 − (−4) = 13）",
      "primary": "BC.MATH.G7.FLU.02", "prereq": ["YY.MATH.INT.ADD"], "misc": ["int.subtract_negative"], "hints": "numberLine" },
    { "id": "YY.MATH.INT.MULT_DIV", "topic": "integers", "type": "procedure", "rep": ["symbolic", "groups"],
      "en": "Multiply and divide integers using the sign rules",
      "zh": "整数乘除：符号规则",
      "primary": "BC.MATH.G7.FLU.02", "prereq": ["YY.MATH.INT.SUBTRACT", "YY.MATH.FLU.MULT.FACTS.DEVELOPING"], "misc": ["int.sign_rules_to_addition"], "hints": "groups" },
    { "id": "YY.MATH.INT.ORDER_OPS", "topic": "integers", "type": "procedure", "rep": ["symbolic"],
      "en": "Use the order of operations with integers, including brackets",
      "zh": "整数的混合运算顺序（含括号）",
      "primary": "BC.MATH.G7.FLU.02", "prereq": ["YY.MATH.INT.MULT_DIV", "YY.MATH.FLU.ORDER_OPS.BRACKETS"], "misc": ["order.left_to_right", "int.sign_rules_to_addition"], "hints": "balance" },
    { "id": "YY.MATH.INT.WORD", "topic": "integers", "type": "apply", "rep": ["context", "numberLine"],
      "en": "Solve problems with integers (temperature changes, elevation, account balances)",
      "zh": "整数应用题（温差、海拔变化、账户余额）",
      "primary": "BC.MATH.G7.FLU.02", "prereq": ["YY.MATH.INT.ORDER_OPS"], "misc": ["int.subtract_negative"], "hints": "numberLine" },

    { "id": "YY.MATH.FLU.MULT.FACTS.EXTENDING", "topic": "decimal-operations", "type": "fluency", "rep": ["symbolic"],
      "en": "Extend mental multiplication and division (×5 = ×10 ÷ 2; 214 × 5 = 1070)",
      "zh": "口算拓展：×5 就是 ×10 再 ÷2（214 × 5 = 1070）",
      "primary": "BC.MATH.G7.FLU.01", "prereq": ["YY.MATH.FLU.MENTAL.MULTI_DIGIT"], "misc": ["mult.x5_one_step_only", "mult.halve_double_direction", "mult.x5_as_double_double", "word.stop_early"], "hints": "areaModel" },
    { "id": "YY.MATH.DEC.OPS.MIXED", "topic": "decimal-operations", "type": "procedure", "rep": ["symbolic"],
      "en": "Add, subtract, multiply and divide decimals fluently",
      "zh": "小数四则运算（熟练）",
      "primary": "BC.MATH.G7.FLU.03", "prereq": ["YY.MATH.DEC.MULT.BY_DECIMAL", "YY.MATH.DEC.DIV.BY_DECIMAL", "YY.MATH.DEC.ADDSUB.1000.ALGORITHM"], "misc": ["dec.ignore_place_align", "dec.mult_point_align"], "hints": "placeValue" },
    { "id": "YY.MATH.DEC.OPS.ORDER_OPS", "topic": "decimal-operations", "type": "procedure", "rep": ["symbolic"],
      "en": "Use the order of operations with decimals, including brackets",
      "zh": "小数的混合运算顺序（含括号）",
      "primary": "BC.MATH.G7.FLU.03", "prereq": ["YY.MATH.DEC.OPS.MIXED", "YY.MATH.FLU.ORDER_OPS.BRACKETS"], "misc": ["order.ignore_brackets"], "hints": "balance" },
    { "id": "YY.MATH.DEC.OPS.WORD", "topic": "decimal-operations", "type": "apply", "rep": ["context"],
      "en": "Solve multi-step decimal problems (shopping totals, unit rates, measurements)",
      "zh": "多步小数应用题（购物总价、单价、测量）",
      "primary": "BC.MATH.G7.FLU.03", "prereq": ["YY.MATH.DEC.OPS.ORDER_OPS", "YY.MATH.DEC.MULTDIV.WORD"], "misc": ["word.keyword_trap"], "hints": "barModel" },

    { "id": "YY.MATH.REL.FRAC_TO_DEC", "topic": "fractions-decimals-percents", "type": "procedure", "rep": ["hundredthsGrid", "symbolic", "numberLine"],
      "en": "Convert a fraction to a decimal by dividing the numerator by the denominator",
      "zh": "分数化小数：分子除以分母",
      "primary": "BC.MATH.G7.NUM.01", "prereq": ["YY.MATH.DEC.DIV.BY_WHOLE", "YY.MATH.DEC.PV1000.FRAC_LINK"],
      "misc": ["rel.frac_to_dec_digits_copy", "rel.divide_wrong_way"], "hints": "numberLine、hundredthsGrid",
      "diag": { "entry": [{ "level": 1, "rep": "hundredthsGrid" }, { "level": 2, "rep": "symbolic" }], "branch": { "rel.frac_to_dec_digits_copy": "YY.MATH.DEC.PV1000.FRAC_LINK", "rel.divide_wrong_way": "YY.MATH.DEC.DIV.BY_WHOLE" } } },
    { "id": "YY.MATH.REL.DEC_TO_FRAC", "topic": "fractions-decimals-percents", "type": "procedure", "rep": ["symbolic", "hundredthsGrid"],
      "en": "Convert a decimal to a fraction in lowest terms",
      "zh": "小数化成最简分数",
      "primary": "BC.MATH.G7.NUM.01", "prereq": ["YY.MATH.DEC.PV1000.FRAC_LINK", "YY.MATH.FRAC.EQUIV.DIVIDE"],
      "misc": ["frac.not_lowest_terms", "dec.tenths_hundredths_confuse"], "hints": "hundredthsGrid",
      "diag": { "entry": [{ "level": 2, "rep": "symbolic" }], "branch": { "frac.not_lowest_terms": "YY.MATH.FRAC.EQUIV.DIVIDE", "dec.tenths_hundredths_confuse": "YY.MATH.DEC.PV1000.READ_WRITE" } } },
    { "id": "YY.MATH.REL.PCT_CONVERT", "topic": "fractions-decimals-percents", "type": "procedure", "rep": ["hundredthsGrid", "symbolic"],
      "en": "Convert among percents, fractions and decimals (3/8 = 0.375 = 37.5%)",
      "zh": "百分数、分数、小数互化（3/8 = 0.375 = 37.5%）",
      "primary": "BC.MATH.G7.NUM.01", "prereq": ["YY.MATH.REL.FRAC_TO_DEC", "YY.MATH.PCT.FRAC_DEC_LINK"],
      "misc": ["pct.decimal_shift_wrong", "pct.percent_as_number"], "hints": "hundredthsGrid",
      "diag": { "entry": [{ "level": 2, "rep": "symbolic" }], "branch": { "pct.decimal_shift_wrong": "YY.MATH.PCT.FRAC_DEC_LINK", "pct.percent_as_number": "YY.MATH.PCT.MEANING" } } },
    { "id": "YY.MATH.REL.RATIO_LINK", "topic": "fractions-decimals-percents", "type": "represent", "rep": ["barModel", "symbolic"],
      "en": "Write a part-to-whole ratio as a fraction, decimal and percent (50:100 = 1/2 = 0.5 = 50%)",
      "zh": "部分比整体的比写成分数、小数、百分数（50:100 = 1/2 = 0.5 = 50%）",
      "primary": "BC.MATH.G7.NUM.01", "prereq": ["YY.MATH.RATIO.PART_PART_WHOLE", "YY.MATH.REL.PCT_CONVERT"],
      "misc": ["ratio.part_whole_confuse"], "hints": "barModel",
      "diag": { "entry": [{ "level": 2, "rep": "barModel" }], "branch": { "ratio.part_whole_confuse": "YY.MATH.RATIO.PART_PART_WHOLE" } } },
    { "id": "YY.MATH.REL.TERMINATING_REPEATING", "topic": "fractions-decimals-percents", "type": "concept", "rep": ["symbolic"],
      "en": "Tell terminating from repeating decimals and write repeating decimals with bar notation",
      "zh": "区分有限小数和循环小数，会写循环节",
      "primary": "BC.MATH.G7.NUM.01", "prereq": ["YY.MATH.REL.FRAC_TO_DEC", "YY.MATH.NUM.PRIME_FACTORIZATION"],
      "misc": ["rel.repeating_rounds_to_terminating"], "hints": "numberLine",
      "diag": { "entry": [{ "level": 2, "rep": "symbolic" }], "branch": { "rel.repeating_rounds_to_terminating": "YY.MATH.REL.FRAC_TO_DEC" } } },
    { "id": "YY.MATH.REL.BENCHMARKS", "topic": "fractions-decimals-percents", "type": "fluency", "rep": ["symbolic", "numberLine"],
      "en": "Know common benchmarks by heart (1/4 = 0.25 = 25%, 1/3 ≈ 0.33, 3/4 = 75%)",
      "zh": "常用基准值记熟（1/4 = 0.25 = 25%，1/3 ≈ 0.33，3/4 = 75%）",
      "primary": "BC.MATH.G7.NUM.01", "prereq": ["YY.MATH.REL.PCT_CONVERT"],
      "misc": ["rel.third_is_0_3"], "hints": "numberLine",
      "diag": { "entry": [{ "level": 1, "rep": "symbolic" }], "branch": { "rel.third_is_0_3": "YY.MATH.REL.FRAC_TO_DEC" } } },
    { "id": "YY.MATH.REL.COMPARE_ORDER", "topic": "fractions-decimals-percents", "type": "reason", "rep": ["numberLine", "symbolic"],
      "en": "Compare and order a mix of fractions, decimals and percents on a number line",
