      "primary": "BC.MATH.G7.NUM.01", "prereq": ["YY.MATH.REL.PCT_CONVERT", "YY.MATH.REL.BENCHMARKS", "YY.MATH.NUM.BENCHMARK.MIXED_ORDER"],
      "misc": ["dec.longer_is_bigger", "frac.bigger_denominator_bigger", "pct.percent_as_number"], "hints": "numberLine",
      "diag": { "entry": [{ "level": 2, "rep": "numberLine" }, { "level": 3, "rep": "symbolic" }], "branch": { "dec.longer_is_bigger": "YY.MATH.DEC.PV1000.COMPARE", "frac.bigger_denominator_bigger": "YY.MATH.FRAC.COMPARE.UNLIKE", "pct.percent_as_number": "YY.MATH.PCT.MEANING" } } },
    { "id": "YY.MATH.REL.APPLY", "topic": "fractions-decimals-percents", "type": "apply", "rep": ["context", "barModel"],
      "en": "Choose the best representation to solve a real problem (survey results, shoreline cleanup data, discounts)",
      "zh": "选最合适的表示方式解决实际问题（调查结果、海岸清理数据、折扣）",
