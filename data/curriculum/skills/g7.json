      "misc": ["ratio.part_whole_confuse", "pct.of_vs_off"], "hints": "barModel",
      "diag": { "entry": [{ "level": 3, "rep": "context" }], "branch": { "ratio.part_whole_confuse": "YY.MATH.REL.RATIO_LINK", "pct.of_vs_off": "YY.MATH.PCT.DISCOUNT" } } },

