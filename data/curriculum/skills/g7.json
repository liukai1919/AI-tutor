    { "id": "YY.MATH.ALG.EQ.TWOSTEP.MODEL", "topic": "two-step-equations", "type": "represent", "rep": ["balance", "barModel"],
      "en": "Model a two-step equation with a balance, algebra tiles or a bar model",
      "zh": "用天平、代数砖或条形图表示两步方程",
      "primary": "BC.MATH.G7.PAT.02", "prereq": ["YY.MATH.ALG.EQ.BALANCE", "YY.MATH.ALG.EQ.ONESTEP.COEFF"], "misc": ["eq.operate_one_side"], "hints": "balance、barModel" },
    { "id": "YY.MATH.ALG.EQ.TWOSTEP.SOLVE", "topic": "two-step-equations", "type": "procedure", "rep": ["symbolic", "balance"],
      "en": "Solve two-step equations (3x + 4 = 16) by undoing operations in order",
      "zh": "解两步方程（3x + 4 = 16）：按顺序逆运算",
      "primary": "BC.MATH.G7.PAT.02", "prereq": ["YY.MATH.ALG.EQ.TWOSTEP.MODEL"], "misc": ["eq.undo_wrong_order", "eq.coefficient_subtract", "eq.operate_one_side"], "hints": "balance" },
    { "id": "YY.MATH.ALG.EQ.TWOSTEP.VERIFY", "topic": "two-step-equations", "type": "reason", "rep": ["symbolic"],
      "en": "Verify a solution by substituting it back into the equation",
