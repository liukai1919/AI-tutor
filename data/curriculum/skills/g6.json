      "zh": "用因数树做质因数分解，并用幂写出来（300 = 2² × 3 × 5²）",
      "primary": "BC.MATH.G6.NUM.02", "prereq": ["YY.MATH.NUM.PRIME_COMPOSITE", "YY.MATH.NUM.DIVISIBILITY"],
      "misc": ["pf.stop_at_composite", "pf.exponent_miscount"], "hints": "groups",
