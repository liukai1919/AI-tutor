    { "id": "YY.MATH.NUM.GCF_LCM.APPLY", "topic": "factors-multiples", "type": "apply", "rep": ["context"],
      "en": "Solve problems with GCF and LCM (equal groups, repeating events, simplifying fractions)",
      "zh": "用最大公因数、最小公倍数解决问题（分组、周期相遇、约分）",
      "primary": "BC.MATH.G6.NUM.02", "supporting": ["BC.MATH.G6.NUM.03"], "prereq": ["YY.MATH.NUM.GCF", "YY.MATH.NUM.LCM"],
      "misc": ["gcf_lcm.confuse"], "hints": "dataTable",
      "diag": { "entry": [{ "level": 3, "rep": "context" }], "branch": { "gcf_lcm.confuse": "YY.MATH.NUM.GCF" } } },

