      "misc": ["factor.miss_pair", "factor.multiple_confuse"], "hints": "areaGrid、hundredChart",
      "diag": { "entry": [{ "level": 1, "rep": "areaGrid" }, { "level": 2, "rep": "symbolic" }], "branch": { "factor.multiple_confuse": "YY.MATH.FLU.DIV.MEANING", "mult.fact_error": "YY.MATH.FLU.MULT.FACTS.EMERGING" } } },
    { "id": "YY.MATH.NUM.MULTIPLES.LIST", "topic": "factors-multiples", "type": "procedure", "rep": ["hundredChart", "symbolic"],
