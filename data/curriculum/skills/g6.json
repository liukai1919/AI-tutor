    { "id": "YY.MATH.NUM.GCF", "topic": "factors-multiples", "type": "procedure", "rep": ["symbolic", "dataTable"],
      "en": "Find the greatest common factor of two numbers (listing, Venn diagram, prime factors)",
      "zh": "求两个数的最大公因数（列举法、维恩图、质因数法）",
      "primary": "BC.MATH.G6.NUM.02", "prereq": ["YY.MATH.NUM.FACTORS.LIST", "YY.MATH.NUM.PRIME_FACTORIZATION"],
      "misc": ["gcf_lcm.confuse", "gcf.pick_any_common"], "hints": "dataTable",
      "diag": { "entry": [{ "level": 2, "rep": "symbolic" }], "branch": { "gcf_lcm.confuse": "YY.MATH.NUM.FACTORS.LIST", "gcf.pick_any_common": "YY.MATH.NUM.FACTORS.LIST" } } },
    { "id": "YY.MATH.NUM.LCM", "topic": "factors-multiples", "type": "procedure", "rep": ["symbolic", "hundredChart"],
      "en": "Find the least common multiple of two numbers",
      "zh": "求两个数的最小公倍数",
      "primary": "BC.MATH.G6.NUM.02", "prereq": ["YY.MATH.NUM.MULTIPLES.LIST", "YY.MATH.NUM.PRIME_FACTORIZATION"],
      "misc": ["gcf_lcm.confuse", "lcm.product_always"], "hints": "hundredChart",
