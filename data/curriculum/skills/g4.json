    { "id": "YY.MATH.FLU.MULT.FACTS.2_5_10", "topic": "mult-div", "type": "fluency", "rep": ["symbolic", "hundredChart"],
      "en": "Recall multiplication facts for 2s, 5s and 10s",
      "zh": "2、5、10 的乘法口诀（能直接说出）",
