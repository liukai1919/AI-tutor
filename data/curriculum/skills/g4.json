    { "id": "YY.MATH.FLU.MULT.FACTS.PATTERNS", "topic": "mult-div", "type": "procedure", "rep": ["hundredChart", "symbolic"],
      "en": "Use patterns, doubling and halving to work out other multiplication facts",
      "zh": "用百数表规律、翻倍减半推出其他乘法口诀",
