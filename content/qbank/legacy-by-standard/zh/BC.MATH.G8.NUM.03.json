 "questions": [
  {
   "qid": "qmt3eh6y92ovwuk",
   "level": 1,
   "question": "½% 的 200 等于多少？",
   "options": [
    "10",
    "1",
    "100",
    "0.5"
   ],
   "answerIndex": 1,
   "explain": "½% = 0.5% = 0.005，所以 0.005 × 200 = 1。最容易踩的坑是把 ½% 看成 ½（即 50%）或 5%，少算或多数个零。"
  },
  {
   "qid": "qmt3eh6y9c9ypl7",
   "level": 1,
   "question": "125% 的 80 等于多少？",
   "options": [
    "80",
    "125",
    "100",
    "60"
   ],
   "answerIndex": 2,
   "explain": "125% = 1.25，1.25 × 80 = 100。超过 100% 的百分数表示\"比原来多\"，不是\"减去 25%\"。"
  },
  {
   "qid": "qmt3eh6y9v8dhnf",
   "level": 1,
   "question": "0.25% 的 4 000 等于多少？",
   "options": [
    "10",
    "100",
    "25",
    "40"
   ],
   "answerIndex": 0,
   "explain": "0.25% = 0.0025，0.0025 × 4 000 = 10。小数百分数要先去掉百分号（÷100）再乘，漏掉这一步就会多一个零。"
  },
  {
   "qid": "qmt3eh6y9ddjzo4",
   "level": 1,
   "question": "一款电子游戏原价 $40，价格涨了 150%（increased by 150%），现在卖多少？",
   "options": [
    "$60",
    "$190",
    "$40",
    "$100"
   ],
   "answerIndex": 3,
   "explain": "\"涨了 150%\"意味着新价 = 原价 + 150%×原价 = 40 + 60 = $100。常见错误：把 150% 的增量直接当新价（$60），或把百分号去掉直接加 150（$190）。"
  },
  {
   "qid": "qmt3eh6y9dxjh3c",
   "level": 2,
   "question": "一位工人的工资三年内涨了 120%（percent increase）。她现在的工资是 $66,000，原来的工资是多少？",
   "options": [
    "$55,000",
    "$30,000",
    "$79,200",
    "$26,400"
   ],
   "answerIndex": 1,
   "explain": "涨了 120% 意味着新值 = 原值 ×(1 + 1.20) = 原值 × 2.20。所以原值 = 66,000 ÷ 2.20 = $30,000。最典型的错误是除以 1.2 得到 $55,000——忘了那个\"1+\"。"
  },
  {
   "qid": "qmt3eh6y97ej504",
   "level": 2,
   "question": "10 亿（1 billion = 1,000,000,000）的 ½% 是多少？",
   "options": [
    "5,000,000",
    "50,000,000",
    "500,000",
    "50,000"
   ],
   "answerIndex": 0,
   "explain": "½% = 0.5% = 0.005。1,000,000,000 × 0.005 = 5,000,000。把 ½% 误当成 5% 就会多算一个零（得 50,000,000）。"
  },
  {
   "qid": "qmt3eh6y9wzi4r7",
   "level": 2,
   "question": "温哥华人口增长了 3.25%。去年约为 603,500 人，现在大约有多少人？",
   "options": [
    "603,825",
    "1,961,375",
    "583,886",
    "623,114"
   ],
   "answerIndex": 3,
   "explain": "新人口 = 603,500 ×(1 + 0.0325) = 603,500 × 1.0325 ≈ 623,114。把 3.25% 直接当 325 或 3.25 来乘是最常见的错。"
  },
  {
   "qid": "qmt3eh6y92vxshl",
   "level": 2,
   "question": "一位学生做串珠（beading）手工，她用掉了一袋 800 颗珠子的 ¾%。她用了几颗？",
   "options": [
    "60",
    "7.5",
    "6",
    "75"
   ],
   "answerIndex": 2,
   "explain": "¾% = 0.75% = 0.0075。800 × 0.0075 = 6 颗。容易把 ¾% 看成 ¾（75%）或 7.5%，少写一个零就多算 10 倍。"
  },
  {
   "qid": "qmt3eh6y955xk5i",
   "level": 3,
   "question": "一家店贴出告示：\"今年价格 = 去年价格的 150%！\"（Prices are now 150% of last year's.）一件去年卖 $60 的夹克，今年卖多少？",
   "options": [
    "$150",
    "$120",
    "$90",
    "$180"
   ],
   "answerIndex": 2,
   "explain": "题目说的是\"是去年价格的 150%\"，即 60 × 1.5 = $90。这和\"涨了 150%\"（= 60 + 90 = $150）不同。辨析\"是…的 150%\"与\"涨了 150%\"是这类题的核心考点。"
  },
  {
   "qid": "qmt3eh6y95wz5c0",
   "level": 3,
   "question": "小明的数学小测从 40 分升到 44 分。他的分数增长（percent increase）了多少？",
   "options": [
    "9.1%",
    "4%",
    "11%",
    "10%"
   ],
   "answerIndex": 3,
   "explain": "增长百分比 =（新 − 旧）÷ 旧 × 100% = 4 ÷ 40 × 100% = 10%。分母必须用原来的值 40；若误用新值 44 做分母，就会得到约 9.1%。"
  },
  {
   "qid": "qmt3eh6y9rxjme1",
   "level": 3,
   "question": "某小镇人口从 200,000 减少了 2.5%（percent decrease）。现在有多少人？",
   "options": [
    "195,000",
    "199,997.5",
    "190,000",
    "197,500"
   ],
   "answerIndex": 0,
   "explain": "减少 2.5% = 200,000 × 0.025 = 5,000 人，新值 = 200,000 − 5,000 = 195,000。把 2.5% 当成\"减去 2.5 个\"（得 199,997.5）是最典型的单位错误。"
  },
  {
   "qid": "qmt3eh6y9u7fjdi",
   "level": 3,
   "question": "一袋咖啡原价 $25。先涨价 20%，后来又降价 20%。最终价格是多少？",
   "options": [
    "$25",
    "$24",
    "$26",
    "$24.50"
   ],
   "answerIndex": 1,
   "explain": "先涨：25 × 1.2 = $30；再降：30 × 0.8 = $24。两次 20% 的基准不同（25 vs 30），所以不会回到原价。以为\"先涨后降同比例就回到原价\"是最常见的直觉错误。"
  }
 ]
}