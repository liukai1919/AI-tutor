# 本地配置（含访问码 / API key），不要提交
config.json

# 语音合成缓存
tts-cache/

# 历史记录 / 学习进度 / FSA 卷 / 闯关题库（用户数据）
# （根目录三个单例是旧版遗留：创建第一个孩子时自动迁入 data/kids/）
history.json
history.json.tmp
progress.json
progress.json.tmp
fsa-sets.json
fsa-sets.json.tmp
qbank.json
qbank.json.tmp

# 账号 / 会话 / 按孩子分桶的学习数据
data/users.json
data/users.json.tmp
data/sessions.json
data/sessions.json.tmp
data/kids/

node_modules/
*.log

# 书籍原文件（版权材料，只留本地）。必须锚定根目录：不带斜杠会连
# data/curriculum/books/（书籍课程数据，要进 git）一起忽略掉。
/books/

# 每小节的讲课参考：来自版权教材（文字层的书是原文，扫描件是提要），
# 本仓库公开，所以只留本地、不入库。缺了也能正常讲课，只是讲法不再贴着
# 原书走。有书的人用 tools/books/ 几分钟就能重新生成，见那里的 README。
data/curriculum/books/text/
# 构建期工具的依赖
tools/books/node_modules/
tools/books/package-lock.json

# 打包产物（里面有下载来的 Node 运行时，几十上百 MB）
build/

# 预烘语音包：1000+ 个 m4a、150 MB 以上的二进制。进了 git 历史就永远删不掉，
# 所以只当构建产物。clone 下来打包前先跑
#   node tools/prevoice.mjs --langs zh,en （约 3.5 小时，要 CosyVoice 守护进程 + ffmpeg）
# 不跑也能打包，只是装出来的软件只有浏览器那个机械音。
data/voice/

# 反过来，这两样是文本、体积小、不随使用变化，所以【要】进仓库，别加进来：
#   data/lessons/      预生成的 138 节课（1.2 MB）
#   data/unit-tests/   预生成的 40 张单元测试卷（328 KB）

# Vercel demo 的种子题库（tools 下脚本从本地 qbank.json 过滤出 BC.* 键生成，
# 见 api/index.js）。上面的 qbank.json 规则按文件名匹配会把它也挡掉，这里放行。
!demo/qbank.json
